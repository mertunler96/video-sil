{%- comment -%}
  MUNLER slide-out cart drawer.
  Intercepts add-to-cart and the header cart icon, keeps everything on-page
  via the AJAX Cart API (/cart/add.js, /cart.js, /cart/change.js).
  Discounts are entered at checkout, not here (matches the brief).
{%- endcomment -%}
<div class="mun-cart-overlay" id="mun-cart" aria-hidden="true">
  <aside class="mun-cart-panel" role="dialog" aria-modal="true" aria-label="Your bag">
    <header class="mun-cart-head">
      <h2 class="mun-cart-title">Your Bag</h2>
      <button type="button" class="mun-cart-close" aria-label="Close" data-cart-close>&times;</button>
    </header>

    <div class="mun-cart-items" data-cart-items>
      <!-- populated by JS -->
    </div>

    <div class="mun-cart-empty" data-cart-empty hidden>
      <p>Your bag is empty.</p>
      <button type="button" class="mun-cart-continue" data-cart-close>Continue shopping</button>
    </div>

    <footer class="mun-cart-foot" data-cart-foot hidden>
      <div class="mun-cart-reassure">
        <span>Free UK delivery, fully insured</span>
        <span>5-year warranty</span>
      </div>
      <div class="mun-cart-subtotal">
        <span>Subtotal</span>
        <span data-cart-subtotal></span>
      </div>
      <a href="/checkout" class="mun-cart-checkout">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="5" y="11" width="14" height="10" rx="1"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
        Checkout securely
      </a>
      <p class="mun-cart-klarna">or 3 interest-free payments of <span data-cart-klarna></span> with Klarna</p>
      <div class="mun-cart-pay">
        {% for t in shop.enabled_payment_types %}{{ t | payment_type_svg_tag: class: 'mun-cart-pay-icon' }}{% endfor %}
      </div>
    </footer>
  </aside>
</div>

<script>
(function () {
  var overlay = document.getElementById('mun-cart');
  if (!overlay) return;
  var itemsEl   = overlay.querySelector('[data-cart-items]');
  var emptyEl   = overlay.querySelector('[data-cart-empty]');
  var footEl    = overlay.querySelector('[data-cart-foot]');
  var subEl     = overlay.querySelector('[data-cart-subtotal]');
  var klarnaEl  = overlay.querySelector('[data-cart-klarna]');
  var countEl   = document.getElementById('cart-count');

  function money(cents) { return '£' + (cents / 100).toFixed(2); }
  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) { return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]; }); }
  function imgUrl(u, w) { if (!u) return ''; return u + (u.indexOf('?') > -1 ? '&' : '?') + 'width=' + w; }

  function open() { overlay.setAttribute('aria-hidden', 'false'); document.body.style.overflow = 'hidden'; }
  function close() { overlay.setAttribute('aria-hidden', 'true'); document.body.style.overflow = ''; }

  function render(cart) {
    if (countEl) countEl.textContent = cart.item_count;
    var empty = cart.item_count === 0;
    emptyEl.hidden = !empty;
    footEl.hidden = empty;
    itemsEl.hidden = empty;
    if (empty) { itemsEl.innerHTML = ''; return; }

    itemsEl.innerHTML = cart.items.map(function (it) {
      var variant = (it.variant_title && it.variant_title !== 'Default Title') ? '<p class="mun-cart-item-variant">' + esc(it.variant_title) + '</p>' : '';
      return '' +
        '<div class="mun-cart-item" data-key="' + esc(it.key) + '">' +
          '<a href="' + esc(it.url) + '" class="mun-cart-item-img"><img src="' + imgUrl(it.image, 160) + '" alt="' + esc(it.product_title) + '" loading="lazy"></a>' +
          '<div class="mun-cart-item-info">' +
            '<a href="' + esc(it.url) + '" class="mun-cart-item-title">' + esc(it.product_title) + '</a>' +
            variant +
            '<div class="mun-cart-item-row">' +
              '<div class="mun-cart-qty">' +
                '<button type="button" class="mun-cart-qty-btn" data-act="dec" aria-label="Decrease quantity">&minus;</button>' +
                '<span class="mun-cart-qty-val">' + it.quantity + '</span>' +
                '<button type="button" class="mun-cart-qty-btn" data-act="inc" aria-label="Increase quantity">+</button>' +
              '</div>' +
              '<span class="mun-cart-item-price">' + money(it.final_line_price) + '</span>' +
            '</div>' +
            '<button type="button" class="mun-cart-remove" data-act="remove">Remove</button>' +
          '</div>' +
        '</div>';
    }).join('');

    subEl.textContent = money(cart.total_price);
    if (klarnaEl) klarnaEl.textContent = money(Math.round(cart.total_price / 3));
  }

  function refresh(openAfter) {
    return fetch('/cart.js', { headers: { 'Accept': 'application/json' } })
      .then(function (r) { return r.json(); })
      .then(function (cart) { render(cart); if (openAfter) open(); return cart; });
  }

  function change(key, qty) {
    itemsEl.classList.add('is-loading');
    fetch('/cart/change.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ id: key, quantity: qty })
    })
      .then(function (r) { return r.json(); })
      .then(function (cart) { render(cart); itemsEl.classList.remove('is-loading'); });
  }

  // Item qty / remove (event delegation)
  itemsEl.addEventListener('click', function (e) {
    var btn = e.target.closest('[data-act]');
    if (!btn) return;
    var row = e.target.closest('.mun-cart-item');
    if (!row) return;
    var key = row.getAttribute('data-key');
    var qty = parseInt(row.querySelector('.mun-cart-qty-val').textContent, 10) || 1;
    var act = btn.getAttribute('data-act');
    if (act === 'inc') change(key, qty + 1);
    else if (act === 'dec') change(key, Math.max(0, qty - 1));
    else if (act === 'remove') change(key, 0);
  });

  // Intercept add-to-cart forms -> AJAX + open drawer (capture phase, before other handlers)
  document.addEventListener('submit', function (e) {
    var form = e.target;
    if (!form || form.getAttribute('action') !== '/cart/add') return;
    e.preventDefault();
    var btn = form.querySelector('[name="add"]');
    var label = btn ? btn.innerHTML : '';
    if (btn) { btn.disabled = true; }
    fetch('/cart/add.js', { method: 'POST', headers: { 'Accept': 'application/json' }, body: new FormData(form) })
      .then(function (r) { if (!r.ok) throw new Error('add failed'); return r.json(); })
      .then(function () { if (btn) { btn.disabled = false; } return refresh(true); })
      .catch(function () { if (btn) { btn.disabled = false; btn.innerHTML = label; } form.submit(); });
  }, true);

  // Header cart icon -> open drawer instead of navigating
  var cartBtn = document.querySelector('.cart-btn');
  if (cartBtn) {
    cartBtn.addEventListener('click', function (e) { e.preventDefault(); refresh(true); });
  }

  // Close interactions
  overlay.addEventListener('click', function (e) {
    if (e.target === overlay || e.target.hasAttribute('data-cart-close')) close();
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && overlay.getAttribute('aria-hidden') === 'false') close();
  });

  // Populate silently on load so the first open is instant
  refresh(false);
})();
</script>
