{%- comment -%}
  MUNLER welcome popup — 10% off first order (WELCOME10).
  Editorial split layout: lifestyle image + capture panel with success state.
  Uses Shopify's native {% form 'customer' %} (same as the footer newsletter),
  so subscribers reliably land in Shopify email marketing (no third-party app).
  On successful submit the page reloads; we re-open the popup on the success
  state (identified via a sessionStorage flag so the footer form never triggers it).
  Shown once per browser (localStorage), not on cart/checkout/account.
{%- endcomment -%}
<div class="mun-wp-overlay" id="mun-wp" aria-hidden="true">
  <div class="mun-wp-modal" role="dialog" aria-modal="true" aria-label="Ten percent off your first order">
    <button class="mun-wp-close" type="button" aria-label="Close" data-wp-close>&times;</button>

    <div class="mun-wp-media">
      <img class="mun-wp-img mun-wp-img--form"
           src="https://cdn.shopify.com/s/files/1/0993/7928/2251/files/emma-brook-home-1.jpg?v=1785314846&width=760"
           alt="MUNLER Brook mirror styled in a real home" loading="lazy">
      <img class="mun-wp-img mun-wp-img--success"
           src="https://cdn.shopify.com/s/files/1/0993/7928/2251/files/blog-living-fireplace-gold-mirror.jpg?v=1781825224&width=760"
           alt="MUNLER champagne gold Brook mirror above a fireplace" loading="lazy">
    </div>

    <div class="mun-wp-body">
      <div data-wp-panel="form">
        <span class="mun-wp-brand">MUNLER</span>
        <h2 class="mun-wp-title">10% off your first order</h2>
        <p class="mun-wp-sub">Join the list for first look at new pieces, and a little something to begin your space with.</p>
        {%- form 'customer', class: 'mun-wp-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter,welcome-popup">
          <input type="email" class="mun-wp-input" name="contact[email]" placeholder="Email address"
                 required autocomplete="email" aria-label="Email address">
          <button type="submit" class="mun-wp-btn">Get my 10% off</button>
          {%- if form.errors -%}
            <p class="mun-wp-error">Please enter a valid email address.</p>
          {%- endif -%}
          {%- if form.posted_successfully? -%}
            <span id="mun-wp-ok" hidden></span>
          {%- endif -%}
        {%- endform -%}
        <button type="button" class="mun-wp-decline" data-wp-close>No thanks, I&rsquo;ll pay full price</button>
      </div>

      <div data-wp-panel="success" hidden>
        <span class="mun-wp-brand">MUNLER</span>
        <h2 class="mun-wp-title">Welcome in.</h2>
        <p class="mun-wp-sub">Your 10% is ready. Use this code at checkout, we&rsquo;ve sent a copy to your inbox too.</p>
        <div class="mun-wp-code">WELCOME10</div>
        <button type="button" class="mun-wp-btn" data-wp-copy>Copy code</button>
        <button type="button" class="mun-wp-decline" data-wp-close>Continue shopping</button>
      </div>
    </div>
  </div>
</div>

<script>
(function () {
  var KEY = 'mun_wp_seen_v1';
  var overlay = document.getElementById('mun-wp');
  if (!overlay) return;

  var path       = window.location.pathname;
  var formPanel  = overlay.querySelector('[data-wp-panel="form"]');
  var okPanel    = overlay.querySelector('[data-wp-panel="success"]');
  var input      = overlay.querySelector('.mun-wp-input');
  var popForm    = overlay.querySelector('.mun-wp-form');

  function open(success) {
    overlay.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    try { localStorage.setItem(KEY, String(Date.now())); } catch (e) {}
    if (success) {
      overlay.classList.add('mun-wp-is-success');
      if (formPanel) formPanel.hidden = true;
      if (okPanel) okPanel.hidden = false;
    } else {
      setTimeout(function () { if (input) input.focus(); }, 350);
    }
  }
  function close() {
    overlay.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  // Mark that THIS popup was the one submitted (so the footer form never triggers the success modal)
  if (popForm) {
    popForm.addEventListener('submit', function () {
      try { sessionStorage.setItem('mun_wp_pending', '1'); } catch (e) {}
    });
  }

  // Returned from a successful signup via this popup -> show the code
  var okFlag = !!document.getElementById('mun-wp-ok');
  var pending = false;
  try { pending = sessionStorage.getItem('mun_wp_pending') === '1'; } catch (e) {}

  if (okFlag && pending) {
    try { sessionStorage.removeItem('mun_wp_pending'); } catch (e) {}
    open(true);
  } else {
    var seen = false;
    try { seen = !!localStorage.getItem(KEY); } catch (e) {}
    var blocked = /\/(cart|checkout|account)(\/|$)/.test(path);
    if (!seen && !blocked) {
      var timer = setTimeout(function () { open(false); }, 6000);
      var onScroll = function () {
        if (window.scrollY > 600) { clearTimeout(timer); open(false); window.removeEventListener('scroll', onScroll); }
      };
      window.addEventListener('scroll', onScroll, { passive: true });
    }
  }

  overlay.addEventListener('click', function (e) {
    if (e.target === overlay || e.target.hasAttribute('data-wp-close')) close();
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && overlay.getAttribute('aria-hidden') === 'false') close();
  });

  var copyBtn = overlay.querySelector('[data-wp-copy]');
  if (copyBtn) {
    copyBtn.addEventListener('click', function () {
      var code = 'WELCOME10';
      var done = function () { copyBtn.textContent = 'Copied'; setTimeout(function () { copyBtn.textContent = 'Copy code'; }, 1800); };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(code).then(done, done);
      } else { done(); }
    });
  }
})();
</script>
