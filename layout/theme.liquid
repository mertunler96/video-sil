<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta name="facebook-domain-verification" content="2uobhcxudi6hrx7w06ja4usk2zjihz" />
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="{% if template == 'index' %}Premium asymmetrical and full-length mirrors with handcrafted stainless steel frames and ecological glass. Free UK delivery, crafted for the extraordinary home.{% else %}{{ page_description | default: shop.description | default: 'Stainless steel frames and ecological mirrors. Crafted for the extraordinary home.' }}{% endif %}">
  <meta name="google-site-verification" content="{{ settings.google_site_verification | default: 'exJl5lQDjCnemV41M1dhpCzTHevOF8ampm6GFkfMYaY' }}">
  {% if settings.bing_site_verification != blank %}<meta name="msvalidate.01" content="{{ settings.bing_site_verification }}">{% endif %}
  {% if settings.pinterest_site_verification != blank %}<meta name="p:domain_verify" content="{{ settings.pinterest_site_verification }}">{% endif %}
  <title>{% if template == 'index' %}MUNLER | Asymmetrical &amp; Full-Length Mirrors{% elsif page_title %}{{ page_title }} | MUNLER{% else %}MUNLER{% endif %}</title>
  <link rel="canonical" href="{{ canonical_url }}">

  <!-- Favicon -->
  {% if settings.favicon %}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
  {% else %}
    <link rel="icon" type="image/png" href="{{ 'favicon.png' | asset_url }}">
    <link rel="apple-touch-icon" href="{{ 'favicon.png' | asset_url }}">
  {% endif %}

  <!-- Open Graph -->
  {%- assign default_share_image = 'https://munler.co.uk/cdn/shop/files/bu_odanin_farkli_shotlarini_ver__202605231515_91bb8878-aaa5-4548-a64a-2a5e1238b6b5.jpg?width=1200&height=630&crop=center' -%}
  <meta property="og:site_name" content="MUNLER">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:locale" content="en_GB">
  {% if template == 'index' %}
    <meta property="og:type" content="website">
    <meta property="og:title" content="MUNLER | Asymmetrical &amp; Full-Length Mirrors">
    <meta property="og:description" content="{{ shop.description | default: 'Stainless steel frames and ecological mirrors. Crafted for the extraordinary home.' | escape }}">
    {% if settings.share_image %}<meta property="og:image" content="https:{{ settings.share_image | img_url: '1200x630' }}">{% else %}<meta property="og:image" content="{{ default_share_image }}">{% endif %}
  {% elsif template contains 'product' %}
    <meta property="og:type" content="product">
    <meta property="og:title" content="{{ product.title | escape }} | MUNLER">
    <meta property="og:description" content="{{ product.description | strip_html | truncate: 160 | escape }}">
    <meta property="og:image" content="https:{{ product.featured_image | img_url: '1200x630' }}">
    <meta property="product:price:amount" content="{{ product.price | money_without_currency }}">
    <meta property="product:price:currency" content="GBP">
  {% elsif template contains 'collection' %}
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{ collection.title | escape }} | MUNLER">
    <meta property="og:description" content="{{ collection.description | strip_html | truncate: 160 | default: 'Shop the MUNLER collection.' | escape }}">
    {% if collection.image %}<meta property="og:image" content="https:{{ collection.image | img_url: '1200x630' }}">{% elsif settings.share_image %}<meta property="og:image" content="https:{{ settings.share_image | img_url: '1200x630' }}">{% else %}<meta property="og:image" content="{{ default_share_image }}">{% endif %}
  {% else %}
    <meta property="og:type" content="website">
    <meta property="og:title" content="{% if page_title %}{{ page_title | escape }} | MUNLER{% else %}MUNLER{% endif %}">
    <meta property="og:description" content="{{ page_description | default: shop.description | default: 'Stainless steel frames and ecological mirrors. Crafted for the extraordinary home.' | escape }}">
    {% if settings.share_image %}<meta property="og:image" content="https:{{ settings.share_image | img_url: '1200x630' }}">{% else %}<meta property="og:image" content="{{ default_share_image }}">{% endif %}
  {% endif %}
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="@munleruk">
  <meta name="twitter:title" content="{% if template == 'index' %}MUNLER | Asymmetrical &amp; Full-Length Mirrors{% elsif page_title %}{{ page_title | escape }} | MUNLER{% else %}MUNLER{% endif %}">
  <meta name="twitter:description" content="{{ page_description | default: shop.description | default: 'Stainless steel frames and ecological mirrors. Crafted for the extraordinary home.' | escape }}">
  {% if template contains 'product' and product.featured_image %}
    <meta name="twitter:image" content="https:{{ product.featured_image | img_url: '1200x628' }}">
  {% elsif settings.share_image %}
    <meta name="twitter:image" content="https:{{ settings.share_image | img_url: '1200x628' }}">
  {% else %}
    <meta name="twitter:image" content="{{ default_share_image }}">
  {% endif %}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Roboto:wght@300;400;500;700&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">

  {{ content_for_header }}

  <link rel="stylesheet" href="{{ 'style.css' | asset_url }}">
  {% if template contains 'product' %}
    <link rel="stylesheet" href="{{ 'product.css' | asset_url }}">
  {% endif %}
  {% unless template == 'index' or template contains 'product' or template == 'cart' %}
    <link rel="stylesheet" href="{{ 'pages.css' | asset_url }}">
  {% endunless %}
  {%- comment -%}
    v2 loads last so its system wins. style.css stays underneath only to keep
    the JS-bound components (cart drawer, search overlay, mobile menu, welcome
    popup) working while the visual layer is rebuilt on top of them.
  {%- endcomment -%}
  <link rel="stylesheet" href="{{ 'v2.css' | asset_url }}">
  <style>.shopify-policy__title{position:absolute !important;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}.shopify-policy__container{padding-top:calc(var(--header-h) + 2.5rem)}</style>

  {% if template == 'index' %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "MUNLER",
    "url": "{{ shop.url }}",
    {% if settings.share_image %}"logo": "https:{{ settings.share_image | img_url: '600x' }}",{% endif %}
    "description": {{ shop.description | default: 'Stainless steel frames and ecological mirrors. Crafted for the extraordinary home.' | json }},
    "contactPoint": {
      "@type": "ContactPoint",
      "email": "info@munler.co.uk",
      "contactType": "customer service",
      "areaServed": "GB",
      "availableLanguage": "English"
    },
    "sameAs": [
      "https://instagram.com/munleruk",
      "https://pinterest.com/munleruk",
      "https://tiktok.com/@munleruk"
    ]
  }
  </script>
  {% endif %}
</head>
<body>

  <!-- Announcement Bar -->
  <div class="announcement-bar">
    <div class="announcement-track">
      <span>Free UK Delivery</span>
      <span>&nbsp;&nbsp;·&nbsp;&nbsp;</span>
      <span>Stainless steel frames</span>
      <span>&nbsp;&nbsp;·&nbsp;&nbsp;</span>
      <span>Ecological Mirrors</span>
      <span>&nbsp;&nbsp;·&nbsp;&nbsp;</span>
      <span>Free UK Delivery</span>
      <span>&nbsp;&nbsp;·&nbsp;&nbsp;</span>
      <span>Stainless steel frames</span>
      <span>&nbsp;&nbsp;·&nbsp;&nbsp;</span>
      <span>Ecological Mirrors</span>
      <span>&nbsp;&nbsp;·&nbsp;&nbsp;</span>
      <span>Free UK Delivery</span>
      <span>&nbsp;&nbsp;·&nbsp;&nbsp;</span>
      <span>Stainless steel frames</span>
      <span>&nbsp;&nbsp;·&nbsp;&nbsp;</span>
      <span>Ecological Mirrors</span>
    </div>
  </div>

  <!-- Header -->
  <header class="site-header" id="site-header">
    <div class="header-inner">
      <button class="mobile-menu-btn" id="mobile-menu-btn" aria-label="Toggle menu">
        <span></span><span></span><span></span>
      </button>

      <nav class="nav-left">
        <a href="/collections/all" class="nav-link">Shop</a>
        <a href="/collections" class="nav-link">Collections</a>
        <a href="/blogs/news" class="nav-link">Blog</a>
        <a href="/pages/trade" class="nav-link">Trade</a>
      </nav>

      <a href="/" class="site-logo">MUNLER</a>

      <div class="nav-right">
        <a href="/pages/about-munler" class="nav-link">About</a>
        <a href="/pages/contact" class="nav-link">Contact</a>
        <div class="nav-icons">
          <button class="icon-btn" aria-label="Search">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
          </button>
          <a href="{{ routes.account_url }}" class="icon-btn" aria-label="Account">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </a>
          <a href="/cart" class="icon-btn cart-btn" aria-label="Cart">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
            <span class="cart-count" id="cart-count">{{ cart.item_count }}</span>
          </a>
        </div>
      </div>
    </div>

    <div class="mobile-menu" id="mobile-menu">
      <div class="mobile-menu-inner">
        <a href="/collections/all">Shop</a>
        <a href="/collections">Collections</a>
        <a href="/blogs/news">Blog</a>
        <a href="/pages/trade">Trade</a>
        <a href="/pages/about-munler">About</a>
        <a href="/pages/contact">Contact</a>
      </div>
    </div>
  </header>

  <main>
    {{ content_for_layout }}
  </main>

  <!-- Footer -->
  <footer class="site-footer v2-footer">
    <div class="v2-wrap">
      <div class="v2-footer-grid">
        <div>
          <h4>Info</h4>
          <a href="/pages/contact">Contact</a>
          <a href="/pages/about-munler">About Us</a>
          <a href="/pages/shipping-returns">Delivery</a>
          <a href="/policies/refund-policy">Returns</a>
          <a href="/pages/warranty">5 Year Promise</a>
          <a href="/policies/terms-of-service">Terms and Conditions</a>
          <a href="/policies/privacy-policy">Privacy Policy</a>
          <a href="/pages/trade">Trade Registration</a>
        </div>
        <div>
          <h4>Collections</h4>
          {%- assign foot_cols = 'asymmetrical-mirrors,full-length-mirrors,gold-mirrors,wall-mirrors,furniture' | split: ',' -%}
          {%- for h in foot_cols -%}
            {%- assign c = collections[h] -%}
            {%- if c.products_count > 0 %}<a href="{{ c.url }}">{{ c.title }}</a>{% endif -%}
          {%- endfor %}
          <a href="/collections/all">Shop all</a>
          <a href="/blogs/news">Journal</a>
        </div>
        <div>
          <h4>Contact</h4>
          <a href="mailto:info@munler.co.uk">info@munler.co.uk</a>
          <a href="/pages/faq">Frequently asked questions</a>
          <a href="/pages/care-guide">Care guide</a>
          <li style="margin-top:1rem;">Free UK delivery, fully insured<br>and tracked on every order.</li>
        </div>
      </div>

      <div class="v2-footer-news">
        <h3>Join the list</h3>
        <p>
          Be the first to hear about new pieces from MUNLER. Sign up to our
          interior newsletter and receive 10% off your first order.
        </p>
        {% form 'customer' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="v2-news-form">
            <input type="email" name="contact[email]" placeholder="E-mail" aria-label="Email" required>
            <button type="submit" aria-label="Subscribe">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </button>
          </div>
        {% endform %}
      </div>

      <div class="v2-footer-base">
        <div class="v2-social">
          <a href="https://instagram.com/munleruk" aria-label="Instagram" rel="noopener" target="_blank">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
          </a>
          <a href="https://pinterest.com/munleruk" aria-label="Pinterest" rel="noopener" target="_blank">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M9 20c1-4 1.5-6 1.5-6M8.5 11c0-2 1.5-3.5 3.5-3.5S15.5 9 15.5 11c0 2.5-1.5 4-3 4"/></svg>
          </a>
          <a href="https://tiktok.com/@munleruk" aria-label="TikTok" rel="noopener" target="_blank">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><path d="M15 4v9.5a4 4 0 1 1-3-3.87"/><path d="M15 4c.6 2.2 2.2 3.5 4.5 3.7"/></svg>
          </a>
        </div>
        <span>&copy; {{ 'now' | date: '%Y' }} MUNLER. All rights reserved.</span>
      </div>
    </div>
  </footer>

  <script>
  window.MUNLER_SEARCH_PRODUCTS = [{% for p in collections['all'].products limit: 8 %}{name:{{ p.title | json }},img:{{ p.featured_image | img_url: '300x' | prepend: 'https:' | json }},url:{{ p.url | json }},price:{{ p.price | money | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}];
  </script>
  <script src="{{ 'main.js' | asset_url }}" defer></script>

  {% render 'welcome-popup' %}
  {% render 'cart-drawer' %}
</body>
</html>
