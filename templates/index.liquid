{% comment %}Build product URL map by title matching — handles may vary{% endcomment %}
{% assign _url_brook_gold = '/collections/all' %}
{% assign _url_brook_black = '/collections/all' %}
{% assign _url_solenne = '/collections/all' %}
{% assign _url_rib = '/collections/all' %}
{% assign _url_volta = '/collections/all' %}
{% for _p in collections['all'].products %}
  {% assign _tl = _p.title | downcase %}
  {% if _tl contains 'brook' and _tl contains 'champagne' %}{% assign _url_brook_gold = _p.url %}{% endif %}
  {% if _tl contains 'brook' and _tl contains 'black' %}{% assign _url_brook_black = _p.url %}{% endif %}
  {% if _tl contains 'brook' and _tl contains 'matte' %}{% assign _url_brook_black = _p.url %}{% endif %}
  {% if _tl contains 'solenne' %}{% assign _url_solenne = _p.url %}{% endif %}
  {% if _tl contains 'rib' %}{% assign _url_rib = _p.url %}{% endif %}
  {% if _tl contains 'volta' %}{% assign _url_volta = _p.url %}{% endif %}
{% endfor %}

<!-- Hero Slider -->
<section class="hero" id="home">
  <div class="hero-slides">
    <div class="hero-slide hero-slide--mirrors is-active">
      <div class="hero-media">
        <picture>
          <source media="(max-width: 900px)" srcset="{{ 'hero-mirrors-mobile.jpg' | asset_url }}">
          <img src="{{ 'hero-mirrors.jpg' | asset_url }}" alt="MUNLER mirrors in gold and black leaning against a walnut panelled wall" class="hero-img" width="2000" height="1116" fetchpriority="high">
        </picture>
        <div class="hero-overlay"></div>
      </div>
      <div class="hero-content">
        <h1 class="hero-title">The same craft<br><em>New prices, for good</em></h1>
        <p class="hero-desc">Brook from &pound;149 &middot; Solenne &pound;499</p>
        <a href="#products" class="btn btn-light">Shop the Collection</a>
      </div>
    </div>
    <div class="hero-slide hero-slide--video">
      <div class="hero-media">
        <video class="hero-video" data-hero-video muted loop playsinline preload="none"
               poster="{{ 'hero-poster.jpg' | asset_url }}">
          <source src="{{ 'hero.mp4' | asset_url }}" type="video/mp4">
        </video>
        <div class="hero-overlay"></div>
      </div>
      <div class="hero-content">
        <h1 class="hero-title">Crafted for<br><em>the Extraordinary</em></h1>
        <p class="hero-desc">Stainless steel frames &amp; ecological mirrors</p>
        <a href="#products" class="btn btn-light">Explore Collection</a>
      </div>
    </div>
  </div>
  <button class="hero-arrow hero-arrow--prev" aria-label="Previous slide">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
  </button>
  <button class="hero-arrow hero-arrow--next" aria-label="Next slide">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
  </button>
  <div class="hero-dots">
    <button class="hero-dot is-active" aria-label="Slide 1"></button>
    <button class="hero-dot" aria-label="Slide 2"></button>
  </div>
  <div class="hero-scroll"><span>Scroll</span><div class="scroll-line"></div></div>
</section>

<!-- Collections -->
<section class="collections" id="collections">
  <div class="collections-header">
    <span class="section-label">Our Collections</span>
    <h2>Define Your Space</h2>
  </div>
  <div class="collections-grid">
    <div class="collection-card reveal">
      <div class="collection-img-wrap">
        <img src="{{ 'collection-asymmetrical.webp' | asset_url }}" alt="MUNLER asymmetrical wall mirror with a matte black frame above a travertine basin in afternoon light" width="2000" height="1493" loading="lazy">
      </div>
      <div class="collection-info">
        <span class="collection-num">01</span>
        <h3>Asymmetrical Mirrors</h3>
        <a href="/collections/asymmetrical-mirrors" class="link-arrow">Shop Collection <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
      </div>
    </div>
    <div class="collection-card reveal">
      <div class="collection-img-wrap">
        <img src="{{ 'collection-full-length.webp' | asset_url }}" alt="MUNLER Solenne full-length mirror in champagne gold leaning against a slatted walnut wall" width="2000" height="1493" loading="lazy">
      </div>
      <div class="collection-info">
        <span class="collection-num">02</span>
        <h3>Full-Length Mirrors</h3>
        <a href="/collections/full-length-mirrors" class="link-arrow">Shop Collection <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
      </div>
    </div>
  </div>
</section>

<!-- Featured Products -->
<section class="products-section" id="products">
  <div class="section-header">
    <span class="section-label">The Range</span>
  </div>
  <div class="products-band">
  <div class="container">
    <div class="products-grid">
      {% comment %}Show 4 non-Solenne products first, then Solenne as wide card{% endcomment %}
      {% assign fp_count = 0 %}
      {% assign solenne_product = nil %}
      {% for product in collections['all'].products %}
        {% assign tl = product.title | downcase %}
        {% if tl contains 'solenne' %}
          {% assign solenne_product = product %}
        {% elsif fp_count < 4 %}
          {% assign fp_count = fp_count | plus: 1 %}
          {% assign tags_lower = product.tags | join: ',' | downcase %}
          <article class="product-card reveal" onclick="window.location='{{ product.url }}'" style="cursor:pointer">
            <div class="product-img-wrap">
              {%- if product.compare_at_price > product.price -%}
                {%- assign oran = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round -%}
                <span class="sale-badge">-{{ oran }}%</span>
              {%- endif -%}
              <img src="{{ product.featured_image | img_url: '800x' }}"
                   srcset="{{ product.featured_image | img_url: '400x' }} 400w, {{ product.featured_image | img_url: '800x' }} 800w"
                   sizes="(max-width: 600px) 50vw, 25vw"
                   alt="{{ product.title }}" class="product-img-main" width="800" height="1067" loading="lazy">
              {% if product.images[1] %}<img src="{{ product.images[1] | img_url: '800x' }}" alt="{{ product.title }}" class="product-img-hover" width="800" height="1067" loading="lazy">{% endif %}
            </div>
            <div class="product-info">
              <div class="product-meta">
                {% if product.title contains 'Brook' %}
                  <h3 class="product-name">The Brook Mirror</h3>
                  <span class="product-variant">{% if product.title contains '–' %}{{ product.title | split: '–' | last | strip }}{% endif %}</span>
                {% elsif product.title contains '–' %}
                  <h3 class="product-name">{{ product.title | split: '–' | first | strip }}</h3>
                  <span class="product-variant">{{ product.title | split: '–' | last | strip }}</span>
                {% else %}
                  <h3 class="product-name">{{ product.title }}</h3>
                {% endif %}
              </div>
              <span class="product-price">
                {%- if product.compare_at_price > product.price -%}
                  <s class="was">{{ product.compare_at_price | money_without_trailing_zeros }}</s>
                {%- endif -%}
                {{ product.price | money_without_trailing_zeros }}
              </span>
            </div>
          </article>
        {% endif %}
      {% endfor %}
      {% comment %}Solenne Mirror — always last, always wide{% endcomment %}
      {% if solenne_product %}
        <article class="product-card product-card--wide reveal" onclick="window.location='{{ solenne_product.url }}'" style="cursor:pointer">
          <div class="product-img-wrap">
            {%- if solenne_product.compare_at_price > solenne_product.price -%}
              {%- assign solenne_oran = solenne_product.compare_at_price | minus: solenne_product.price | times: 100.0 | divided_by: solenne_product.compare_at_price | round -%}
              <span class="sale-badge">-{{ solenne_oran }}%</span>
            {%- endif -%}
            <img src="{{ solenne_product.featured_image | img_url: '800x' }}"
                   srcset="{{ solenne_product.featured_image | img_url: '400x' }} 400w, {{ solenne_product.featured_image | img_url: '800x' }} 800w"
                   sizes="(max-width: 600px) 100vw, 50vw"
                   alt="{{ solenne_product.title }}" class="product-img-main" width="800" height="1067" loading="lazy">
            {% if solenne_product.images[1] %}<img src="{{ solenne_product.images[1] | img_url: '800x' }}" alt="{{ solenne_product.title }}" class="product-img-hover" width="800" height="1067" loading="lazy">{% endif %}
          </div>
          <div class="product-info">
            <div class="product-meta">
              <h3 class="product-name">The Solenne Mirror</h3>
              <span class="product-variant">Champagne Gold</span>
            </div>
            <span class="product-price">
              {%- if solenne_product.compare_at_price > solenne_product.price -%}
                <s class="was">{{ solenne_product.compare_at_price | money_without_trailing_zeros }}</s>
              {%- endif -%}
              {{ solenne_product.price | money_without_trailing_zeros }}
            </span>
          </div>
        </article>
      {% endif %}
    </div>
    <div class="products-cta">
      <a href="/collections/all" class="link-arrow">Shop all <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
    </div>
  </div>
  </div>
</section>

<!-- Values -->
