<!-- Photo Marquee -->
<section class="photo-marquee">
  <div class="photo-marquee-head">
    <span class="section-label">Styled interiors</span>
  </div>
  <div class="photo-marquee-track">
    {%- assign look_files = 'look-01,look-02,look-03,look-04,look-05,look-06,look-07,look-08,look-09,look-10,look-11,look-12,look-13,look-14' | split: ',' -%}
    {%- assign look_types = 'b,s,b,s,b,s,b,s,b,b,b,s,s,b' | split: ',' -%}
    {%- for pass in (1..2) -%}
      {%- for f in look_files -%}
        {%- assign t = look_types[forloop.index0] -%}
        {%- if t == 's' -%}{%- assign look_url = _url_solenne -%}{%- assign look_name = 'Solenne Mirror' -%}{%- else -%}{%- assign look_url = _url_brook_gold -%}{%- assign look_name = 'Brook Mirror' -%}{%- endif -%}
    <a href="{{ look_url }}" class="photo-marquee-item"{% if pass == 2 %} aria-hidden="true" tabindex="-1"{% endif %}><img src="{{ f | append: '.webp' | asset_url }}" alt="{% if pass == 1 %}{{ look_name }} in a styled interior{% endif %}" width="640" height="857" loading="lazy"><span class="photo-marquee-label">{{ look_name }}</span></a>
      {%- endfor -%}
    {%- endfor %}
  </div>
</section>
