{% comment %}
  MUNLER v2 homepage — redesign2 branch.

  Section order follows the Scandinavian retail pattern the direction was set
  from: hero, bestsellers, brand statement, category rail, lifestyle band,
  two-up categories, real-homes carousel, line art, about, guarantee.

  Everything is pulled from the store rather than hardcoded where it can be:
  products come from collections, prices and badges from variants, the
  carousel from the influencer films already on the CDN. Copy is MUNLER's.
{% endcomment %}

<div class="v2">

{%- assign mirrors = collections['asymmetrical-mirrors'] -%}
{%- assign hero_product = all_products['solenne-champagne-gold-full-length-mirror'] -%}

<!-- ── Hero ─────────────────────────────────────────────────────────── -->
<section class="v2-hero">
  <div class="v2-hero-media">
    <video autoplay muted loop playsinline preload="metadata"
           poster="{{ hero_product.media[1].preview_image | image_url: width: 1600 }}">
      <source src="{{ 'hero.mp4' | asset_url }}" type="video/mp4">
    </video>
  </div>
  <div class="v2-hero-inner">
    <span class="v2-eyebrow">Handmade in small batches</span>
    <h1 class="v2-display v2-h1">Objects to <em>live with</em>,<br>not just look at</h1>
    <p class="v2-hero-sub">
      Sculptural mirrors in brushed stainless steel and ecological glass,
      made for the walls you pass every day.
    </p>
    <a href="/collections/asymmetrical-mirrors" class="v2-btn v2-btn--light">Shop the collection</a>
  </div>
</section>

<!-- ── Ticker ───────────────────────────────────────────────────────── -->
<div class="v2-ticker" aria-hidden="true">
  <div class="v2-ticker-track">
    {% for i in (1..2) %}
      <span>Free UK delivery</span><span>·</span>
      <span>5 year promise</span><span>·</span>
      <span>304 stainless steel</span><span>·</span>
      <span>Copper &amp; lead free glass</span><span>·</span>
      <span>30 day returns</span><span>·</span>
      <span>Made in small batches</span><span>·</span>
    {% endfor %}
  </div>
</div>

<!-- ── Bestsellers ──────────────────────────────────────────────────── -->
<section class="v2-section">
  <div class="v2-wrap">
    <div class="v2-head">
      <span class="v2-eyebrow">The collection</span>
      <h2 class="v2-display v2-h2">Bestsellers</h2>
    </div>

    <div class="v2-grid">
      {%- assign shown = 0 -%}
      {%- for p in mirrors.products -%}
        {%- if shown >= 3 -%}{%- break -%}{%- endif -%}
        <a href="{{ p.url }}" class="v2-card">
          <div class="v2-card-media">
            <div class="v2-badges">
              {%- if p.handle == 'solenne-champagne-gold-full-length-mirror' -%}
                <span class="v2-badge">Signature</span>
              {%- else -%}
                <span class="v2-badge">Bestseller</span>
              {%- endif -%}
            </div>
            <img src="{{ p.featured_media | image_url: width: 800 }}"
                 alt="{{ p.title | escape }}" width="800" height="1000" loading="lazy">
            {%- if p.media[1] -%}
              <img class="is-alt" src="{{ p.media[1] | image_url: width: 800 }}"
                   alt="" width="800" height="1000" loading="lazy" aria-hidden="true">
            {%- endif -%}
          </div>
          <div class="v2-card-text">
            <div class="v2-card-vendor">MUNLER</div>
            <div class="v2-card-title">{{ p.title | split: '–' | first | strip }}</div>
            <div class="v2-card-price">
              {%- if p.variants.size > 1 -%}<small>From</small> {% endif %}{{ p.price | money_without_trailing_zeros }}
            </div>
          </div>
        </a>
        {%- assign shown = shown | plus: 1 -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<!-- ── Brand statement ──────────────────────────────────────────────── -->
<section class="v2-statement">
  <div class="v2-wrap v2-wrap--narrow">
    <p>Made in London, shaped by the quiet <em>architecture</em> of a room</p>
    <a href="/pages/about-munler" class="v2-textlink">Discover the brand</a>
  </div>
</section>

<!-- ── Category rail ────────────────────────────────────────────────── -->
<section class="v2-section v2-section--tight">
  <div class="v2-wrap">
    <div class="v2-rail">
      {%- assign rail = 'asymmetrical-mirrors,full-length-mirrors,gold-mirrors,furniture' | split: ',' -%}
      {%- for h in rail -%}
        {%- assign c = collections[h] -%}
        {%- if c.products_count > 0 -%}
          <a href="{{ c.url }}" class="v2-tile">
            <div class="v2-tile-label">{{ c.title }}</div>
            <div class="v2-tile-media">
              <img src="{{ c.products.first.featured_media | image_url: width: 700 }}"
                   alt="{{ c.title | escape }}" width="700" height="933" loading="lazy">
              <span class="v2-tile-cta">Shop now</span>
            </div>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<!-- ── At home band ─────────────────────────────────────────────────── -->
<section class="v2-band">
  <div class="v2-band-media">
    <img src="{{ all_products['brook-champagne-gold-wall-mirror'].media[2] | image_url: width: 1800 }}"
         alt="A MUNLER mirror in a styled living room" width="1800" height="1200" loading="lazy">
  </div>
  <div class="v2-band-inner">
    <span class="v2-eyebrow">In real homes</span>
    <h2 class="v2-display v2-h2">At home with MUNLER</h2>
    <p>
      Not a showroom and not a render. Scroll through real homes styled with
      MUNLER, and the people who chose to live with them.
    </p>
    <a href="#v2-homes" class="v2-btn v2-btn--light">See the homes</a>
  </div>
</section>

<!-- ── Two-up categories ────────────────────────────────────────────── -->
<section class="v2-section">
  <div class="v2-wrap">
    <div class="v2-grid v2-grid--2">
      {%- assign duo = 'asymmetrical-mirrors,full-length-mirrors' | split: ',' -%}
      {%- for h in duo -%}
        {%- assign c = collections[h] -%}
        <a href="{{ c.url }}" class="v2-tile">
          <div class="v2-tile-label">{{ c.title }}</div>
          <div class="v2-tile-media" style="aspect-ratio: 4 / 3;">
            <img src="{{ c.products.last.media[1] | image_url: width: 1100 }}"
                 alt="{{ c.title | escape }}" width="1100" height="825" loading="lazy">
            <span class="v2-tile-cta">Shop now</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

<!-- ── In your homes ────────────────────────────────────────────────── -->
<section class="v2-section" id="v2-homes">
  <div class="v2-wrap">
    <div class="v2-ugc-head">
      <div>
        <span class="v2-eyebrow">Styled by you</span>
        <h2 class="v2-display v2-h2">In your homes</h2>
      </div>
      <div class="v2-ugc-nav">
        <button type="button" data-ugc="prev" aria-label="Previous">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <button type="button" data-ugc="next" aria-label="Next">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
        </button>
      </div>
    </div>

    {%- comment -%}
      The five influencer films already live on the Shopify CDN. preload="none"
      so five videos on the homepage do not cost five downloads before the
      visitor has scrolled to them.
    {%- endcomment -%}
    {%- assign homes = 'abbey-solenne-home.mp4?v=1786363375|ourberkelyhome|vicky-solenne-home.mp4?v=1784292784|number5.renovation|ellie-brook-home-v2.mp4?v=1784041824|homewithellie1|emma-brook-home-v2.mp4?v=1785315954|thebigger_house|annie-brook-home.mp4?v=1784292783|ourhome_daffodilway' | split: '|' -%}
    <div class="v2-ugc-rail" data-ugc-rail>
      {%- for i in (0..4) -%}
        {%- assign fi = i | times: 2 -%}
        {%- assign hi = fi | plus: 1 -%}
        <div class="v2-ugc-item">
          <video autoplay muted loop playsinline preload="none">
            <source src="https://cdn.shopify.com/s/files/1/0993/7928/2251/files/{{ homes[fi] }}" type="video/mp4">
          </video>
          <span class="v2-ugc-tag">@{{ homes[hi] }}</span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<!-- ── Line art ─────────────────────────────────────────────────────── -->
<section class="v2-line-art">
  <svg viewBox="0 0 700 300" fill="none" stroke="currentColor" stroke-width="1.1"
       stroke-linecap="round" stroke-linejoin="round" role="img"
       aria-label="Line drawing of a leaning mirror beside a console table">
    <path d="M60 268h580"/>
    <path d="M232 268V96c0-30 15-48 42-52 30-4 50 14 52 44 2 30-2 62-4 92l-6 88"/>
    <path d="M246 262V104c0-22 10-36 30-38 22-3 36 10 38 32 1 22-2 50-3 72l-5 92"/>
    <path d="M420 268v-92h168v92"/>
    <path d="M420 200h168"/>
    <path d="M470 176v-30c0-14 10-24 24-24s24 10 24 24v30"/>
    <path d="M494 122V96"/>
    <ellipse cx="494" cy="90" rx="16" ry="7"/>
    <path d="M104 268v-56c0-20 12-32 30-32s30 12 30 32v56"/>
    <path d="M134 180v-22"/>
    <path d="M118 158h32"/>
  </svg>
</section>

<!-- ── About ────────────────────────────────────────────────────────── -->
<section class="v2-section">
  <div class="v2-wrap v2-wrap--narrow" style="text-align:center;">
    <span class="v2-eyebrow" style="margin-bottom:1rem;">About MUNLER</span>
    <h2 class="v2-display v2-h2" style="margin-bottom:1.1rem;">The difference is what it&rsquo;s made of</h2>
    <p class="v2-body" style="max-width:56ch;margin:0 auto 2rem;">
      Two asymmetrical mirrors can look identical in a photograph and be made of
      completely different things. Ours are built on 304-grade stainless steel
      with copper-free, lead-free glass, finished by hand and guaranteed for
      five years.
    </p>
    <a href="/pages/about-munler" class="v2-btn v2-btn--dark">Discover the brand</a>
  </div>
</section>

<!-- ── Guarantee ────────────────────────────────────────────────────── -->
<section class="v2-section v2-section--tight">
  <div class="v2-wrap">
    <div class="v2-guarantee">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>
      </svg>
      <div>
        <h4>Arrives perfect, or we replace it</h4>
        <p>
          Every mirror is crated and fully insured for the journey. If yours
          arrives damaged, send us a photo and we replace it free. We arrange
          and pay for collection. You are never left with a broken mirror you
          paid for.
        </p>
      </div>
    </div>
  </div>
</section>

</div>

<script>
  (function () {
    var rail = document.querySelector('[data-ugc-rail]');
    if (!rail) return;
    document.querySelectorAll('[data-ugc]').forEach(function (b) {
      b.addEventListener('click', function () {
        var step = rail.clientWidth * 0.7;
        rail.scrollBy({ left: b.dataset.ugc === 'next' ? step : -step, behavior: 'smooth' });
      });
    });
  })();
</script>
