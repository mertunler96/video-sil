<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": {{ article.title | json }},
  "image": [{% if article.image %}"https:{{ article.image | img_url: '1200x' }}"{% else %}"{{ shop.url }}"{% endif %}],
  "datePublished": "{{ article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' }}",
  "dateModified": "{{ article.updated_at | date: '%Y-%m-%dT%H:%M:%SZ' }}",
  "author": { "@type": "Organization", "name": "MUNLER" },
  "publisher": {
    "@type": "Organization",
    "name": "MUNLER",
    "url": "{{ shop.url }}"
  },
  "mainEntityOfPage": { "@type": "WebPage", "@id": "{{ shop.url }}{{ article.url }}" },
  "description": {{ article.excerpt_or_content | strip_html | truncate: 200 | json }}
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {"@type":"ListItem","position":1,"name":"Home","item":"{{ shop.url }}"},
    {"@type":"ListItem","position":2,"name":{{ blog.title | json }},"item":"{{ shop.url }}{{ blog.url }}"},
    {"@type":"ListItem","position":3,"name":{{ article.title | json }},"item":"{{ shop.url }}{{ article.url }}"}
  ]
}
</script>

<style>
  .article-head{padding:calc(var(--header-h) + 34px + 4rem) var(--gutter) 2.5rem;text-align:center;max-width:760px;margin:0 auto}
  .article-meta{font-family:var(--font-sans);font-size:.72rem;letter-spacing:.16em;text-transform:uppercase;color:var(--color-gold);margin-bottom:1.2rem}
  .article-title{font-family:var(--font-serif);font-size:clamp(2.2rem,5vw,3.6rem);font-weight:400;line-height:1.1;color:var(--color-dark)}
  .article-hero-img{display:block;width:auto;max-width:min(100%,720px);max-height:90vh;height:auto;margin:1rem auto 3.5rem}
  .article-body{max-width:720px;margin:0 auto;padding:0 var(--gutter) 4rem}
  .article-body p,.article-body li{font-family:var(--font-sans);font-size:1rem;font-weight:300;line-height:1.95;color:#444;margin-bottom:1.3rem}
  .article-body h2{font-family:var(--font-serif);font-size:clamp(1.6rem,3vw,2.2rem);font-weight:400;margin:2.8rem 0 1rem;line-height:1.2}
  .article-body h3{font-family:var(--font-serif);font-size:1.35rem;font-weight:400;margin:2rem 0 .8rem}
  .article-body figure{margin:2.4rem 0}
  .article-body img{display:block;max-width:100%;width:auto;max-height:760px;height:auto;margin:0 auto}
  .article-body figcaption{margin-top:.7rem;text-align:center;font-family:var(--font-sans);font-size:.78rem;font-weight:300;letter-spacing:.02em;color:var(--color-mid)}
  .article-body a{color:var(--color-gold);text-decoration:underline;text-underline-offset:3px}
  .article-body ul,.article-body ol{padding-left:1.3rem;margin-bottom:1.3rem}
  .article-cta{text-align:center;padding:3.5rem var(--gutter) 6rem;border-top:1px solid var(--color-border);max-width:720px;margin:0 auto}
  .article-cta p{font-family:var(--font-serif);font-size:1.5rem;font-weight:400;margin-bottom:1.6rem}
  .article-back{display:inline-block;margin:0 var(--gutter) 4rem;font-family:var(--font-sans);font-size:.72rem;letter-spacing:.16em;text-transform:uppercase;color:var(--color-mid);text-decoration:none}
  .article-back:hover{color:var(--color-gold)}
  .article-shop{max-width:980px;margin:0 auto;padding:3.5rem var(--gutter) 1rem;border-top:1px solid var(--color-border);text-align:center}
  .article-shop-eyebrow{font-family:var(--font-sans);font-size:.72rem;letter-spacing:.16em;text-transform:uppercase;color:var(--color-gold);margin-bottom:.9rem}
  .article-shop-title{font-family:var(--font-serif);font-size:clamp(1.7rem,3.2vw,2.3rem);font-weight:400;line-height:1.2;color:var(--color-dark);margin-bottom:2.2rem}
  .article-shop-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem;text-align:center}
  .article-shop-card{display:block;color:inherit;text-decoration:none}
  .article-shop-card .product-img-wrap{margin-bottom:.9rem}
  .article-shop-note{font-family:var(--font-sans);font-size:.78rem;font-weight:300;letter-spacing:.04em;color:var(--color-mid);margin:2rem 0 0}
  .article-shop-3d{display:block;font-family:var(--font-sans);font-size:.66rem;letter-spacing:.14em;text-transform:uppercase;color:var(--color-gold)}
  .article-mid{display:grid;grid-template-columns:120px 1fr;gap:1.4rem;align-items:center;margin:2.6rem 0;padding:1rem;border:1px solid var(--color-border);color:inherit;text-decoration:none!important}
  .article-mid img{width:120px;height:160px;object-fit:cover;margin:0}
  .article-mid-eyebrow{display:block;font-family:var(--font-sans);font-size:.66rem;letter-spacing:.16em;text-transform:uppercase;color:var(--color-gold);margin-bottom:.4rem}
  .article-mid-name{display:block;font-family:var(--font-serif);font-size:1.2rem;color:var(--color-dark);line-height:1.25;margin-bottom:.3rem}
  .article-mid-price{display:block;font-family:var(--font-sans);font-size:.85rem;letter-spacing:.06em;color:var(--color-dark);margin-bottom:.5rem}
  .article-mid-link{display:block;font-family:var(--font-sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--color-gold)}
  @media(max-width:760px){
    .article-shop-grid{grid-template-columns:1fr;gap:1.2rem}
    .article-shop-card{display:grid;grid-template-columns:38% 1fr;gap:1rem;align-items:center;text-align:left}
    .article-shop-card .product-img-wrap{margin-bottom:0}
    .article-shop-card .product-info{align-items:flex-start;text-align:left}
    .article-mid{grid-template-columns:96px 1fr;gap:1rem}
    .article-mid img{width:96px;height:128px}
  }
</style>

<article>
  <header class="article-head">
    <p class="article-meta">{{ article.published_at | date: '%B %d, %Y' }}{% if article.tags.size > 0 %} · {{ article.tags.first }}{% endif %}</p>
    <h1 class="article-title">{{ article.title }}</h1>
  </header>

  {% if article.image %}
    <img src="{{ article.image | img_url: '1200x' }}" alt="{{ article.image.alt | default: article.title }}" class="article-hero-img" loading="eager">
  {% endif %}

  <div class="article-body rte">
    {{ article.content }}
  </div>

  {%- assign shop_handles = 'brook-matte-black-wall-mirror,brook-champagne-gold-wall-mirror,solenne-champagne-gold-full-length-mirror' | split: ',' -%}
  <section class="article-shop" aria-labelledby="article-shop-title">
    <p class="article-shop-eyebrow">The mirrors in this guide</p>
    <h2 class="article-shop-title" id="article-shop-title">Find yours</h2>
    <div class="article-shop-grid">
      {%- for h in shop_handles -%}
        {%- assign product = all_products[h] -%}
        {%- if product.title != blank -%}
        <a class="article-shop-card" href="{{ product.url }}">
          <div class="product-img-wrap">
            {%- if product.compare_at_price > product.price -%}
              {%- assign indirim_oran = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round -%}
              <span class="sale-badge">-{{ indirim_oran }}%</span>
            {%- endif -%}
            {%- if product.featured_image -%}
              <img src="{{ product.featured_image | img_url: '600x' }}" srcset="{{ product.featured_image | img_url: '400x' }} 400w, {{ product.featured_image | img_url: '600x' }} 600w, {{ product.featured_image | img_url: '800x' }} 800w" sizes="(max-width: 760px) 38vw, 300px" alt="{{ product.title | escape }}" class="product-img-main" width="600" height="800" loading="lazy">
            {%- endif -%}
            {%- if product.images[1] -%}
              <img src="{{ product.images[1] | img_url: '600x' }}" alt="" class="product-img-hover" width="600" height="800" loading="lazy">
            {%- endif -%}
          </div>
          <div class="product-info">
            <div class="product-meta">
              <h3 class="product-name">{% if product.title contains 'Brook' %}The Brook Mirror{% else %}The Solenne Mirror{% endif %}</h3>
              <span class="product-variant">{% if product.title contains '–' %}{{ product.title | split: '–' | last | strip }}{% endif %}</span>
            </div>
            <span class="product-price">
              {%- if product.compare_at_price > product.price -%}<s class="was">{{ product.compare_at_price | money_without_trailing_zeros }}</s> {% endif -%}
              {%- if product.price_varies %}From {% endif %}{{ product.price | money_without_trailing_zeros }}
            </span>
            <span class="article-shop-3d">See it on your wall in 3D</span>
          </div>
        </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
    <p class="article-shop-note">Free UK delivery · 30-day returns · Delivered in 3 to 5 working days</p>
  </section>

  {%- assign mid = all_products['brook-matte-black-wall-mirror'] -%}
  {%- if mid.title != blank -%}
  <template id="article-mid-card">
    <a class="article-mid" href="{{ mid.url }}">
      {%- if mid.featured_image -%}<img src="{{ mid.featured_image | img_url: '300x' }}" alt="{{ mid.title | escape }}" width="120" height="160" loading="lazy">{%- endif -%}
      <span>
        <span class="article-mid-eyebrow">The Brook Mirror</span>
        <span class="article-mid-name">Asymmetrical wall mirror in matte black or champagne gold</span>
        <span class="article-mid-price">{% if mid.price_varies %}From {% endif %}{{ mid.price | money_without_trailing_zeros }}</span>
        <span class="article-mid-link">See it on your wall in 3D</span>
      </span>
    </a>
  </template>
  <script>
  (function(){
    var t = document.getElementById('article-mid-card'), body = document.querySelector('.article-body');
    if(!t || !body) return;
    var h2s = body.querySelectorAll('h2'), node = t.content.cloneNode(true);
    if(h2s.length >= 3) h2s[2].parentNode.insertBefore(node, h2s[2]); else body.appendChild(node);
  })();
  </script>
  {%- endif -%}

  <div class="article-cta">
    <p>Bring the look home.</p>
    <a href="/collections/all" class="btn btn-dark">Shop the Collection</a>
  </div>
</article>

<a href="{{ blog.url }}" class="article-back">← Back to {{ blog.title }}</a>

{% if blog.comments_enabled? %}
<section class="article-body" style="padding-top:0">
  {% if article.comments_count > 0 %}
    <h2 style="font-family:var(--font-serif);font-weight:400;margin-bottom:1.5rem">Comments ({{ article.comments_count }})</h2>
    {% for comment in article.comments %}
      <div style="border-top:1px solid var(--color-border);padding:1.5rem 0">
        <p style="margin-bottom:.4rem">{{ comment.content }}</p>
        <p style="font-size:.8rem;color:var(--color-mid)">— {{ comment.author }}</p>
      </div>
    {% endfor %}
  {% endif %}
</section>
{% endif %}
