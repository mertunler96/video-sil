<section class="page-hero">
  <span class="section-label" style="color:var(--color-gold);">Curated</span>
  <h1 class="page-hero-title">Collections</h1>
  <p class="page-hero-desc">Distinct collections, one consistent vision: objects that endure and elevate.</p>
</section>

<section class="collections-page-section">
  <div class="container">
    <div class="collections-grid collections-list-grid">
      {% assign col_counter = 0 %}
      {% assign list_handles = 'asymmetrical-mirrors,full-length-mirrors,wall-mirrors,gold-mirrors,furniture' | split: ',' %}
      {% for h in list_handles %}
        {% assign collection = collections[h] %}
        {% unless collection == blank or collection.products_count == 0 %}
          {% assign col_counter = col_counter | plus: 1 %}
          <div class="collection-card reveal">
            <a class="collection-img-wrap" href="{{ collection.url }}" aria-label="{{ collection.title }}">
              {%- if collection.handle == 'asymmetrical-mirrors' -%}
                <img src="{{ 'collection-asymmetrical.webp' | asset_url }}" alt="{{ collection.title }}" width="2000" height="1493" loading="lazy">
              {%- elsif collection.handle == 'full-length-mirrors' -%}
                <img src="{{ 'collection-full-length.webp' | asset_url }}" alt="{{ collection.title }}" width="2000" height="1493" loading="lazy">
              {%- else -%}
                {%- assign cover = collection.image | default: collection.products.first.images[1] | default: collection.products.first.featured_image -%}
                {%- if cover -%}<img src="{{ cover | img_url: '1200x' }}" alt="{{ collection.title }}" loading="lazy">{%- endif -%}
              {%- endif -%}
            </a>
            <div class="collection-info">
              <span class="collection-num">0{{ col_counter }}</span>
              <h3>{{ collection.title }}</h3>
              <a href="{{ collection.url }}" class="link-arrow">Shop collection <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
            </div>
          </div>
        {% endunless %}
      {% endfor %}
    </div>
  </div>
</section>
